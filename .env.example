# =============================================================================
# BPFQuest Environment Configuration Template (Stage 3)
# =============================================================================
# Copy this file to .env.local for local development.
# Do NOT commit actual secrets or production credentials to source control.

# Application Configuration
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BPFQuest
NEXT_PUBLIC_APP_VERSION=0.1.0

# Database Configuration (PostgreSQL with Prisma)
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bpfquest?schema=public"

# NextAuth / Auth.js Configuration
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your-32-byte-base64-secret-here
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth Provider (Optional for local development, required for GitHub login)
# Register at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Future Lab Orchestration (Stage 5+)
# LAB_ORCHESTRATION_SERVICE_URL=http://localhost:8080
# LAB_ORCHESTRATION_TOKEN=placeholder-token
